#!/bin/bash
# Debug version of vox with detailed error reporting

GREEN='\033[0;32m'
BLUE='\033[0;34m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

echo -e "${BLUE}🔍 VOX DEBUG MODE${NC}"

# First, let's check if the Python packages are properly installed
echo -e "${BLUE}📦 Checking Python dependencies...${NC}"
python3 -c "
import sys
import platform
print(f'Python version: {sys.version}')
print(f'Platform: {platform.system()} {platform.machine()}')

is_apple_silicon = (platform.system() == 'Darwin' and platform.machine() == 'arm64')
if is_apple_silicon:
    print('🍎 Apple Silicon detected - Parakeet MLX is primary engine')
else:
    print('💻 Non-Apple Silicon - faster-whisper is primary engine')

try:
    import parakeet_mlx
    print(f'✅ parakeet-mlx installed (primary on Apple Silicon)')
except ImportError as e:
    if is_apple_silicon:
        print(f'⚠️  parakeet-mlx not found: {e} (install with: pip install parakeet-mlx)')
    else:
        print(f'ℹ️  parakeet-mlx not available (Apple Silicon only)')

try:
    import faster_whisper
    print(f'✅ faster-whisper version: {faster_whisper.__version__}')
except ImportError as e:
    print(f'❌ faster-whisper not found: {e}')

try:
    import soundfile
    print(f'✅ soundfile version: {soundfile.__version__}')
except ImportError as e:
    print(f'❌ soundfile not found: {e}')

try:
    import numpy
    print(f'✅ numpy version: {numpy.__version__}')
except ImportError as e:
    print(f'❌ numpy not found: {e}')
"

echo ""
echo -e "${BLUE}🎤 Starting recording test...${NC}"

# Cleanup old debug recordings first
find /tmp -name "vox_debug_*.wav" -type f -mmin +60 -delete 2>/dev/null || true

TEMP_FILE="/tmp/vox_debug_$(date +%s).wav"

# Test recording
echo -e "${YELLOW}Press ENTER when done speaking (recording for max 10 seconds)...${NC}"

if [[ "$OSTYPE" == "darwin"* ]]; then
    if command -v sox &> /dev/null; then
        echo "Using sox for recording..."
        timeout 10 sox -d -r 16000 -c 1 -b 16 "$TEMP_FILE" &
        REC_PID=$!
        read -n 1 -s
        kill $REC_PID 2>/dev/null
        wait $REC_PID 2>/dev/null
    else
        echo "Sox not found, using ffmpeg..."
        timeout 10 ffmpeg -f avfoundation -i ":0" -ar 16000 -ac 1 -acodec pcm_s16le "$TEMP_FILE" -y &
        REC_PID=$!
        read -n 1 -s
        kill $REC_PID 2>/dev/null
        wait $REC_PID 2>/dev/null
    fi
fi

# Check if file was created
if [[ ! -f "$TEMP_FILE" ]]; then
    echo -e "${RED}❌ Recording file not created${NC}"
    exit 1
fi

# Check file size
FILE_SIZE=$(stat -f%z "$TEMP_FILE" 2>/dev/null || stat -c%s "$TEMP_FILE" 2>/dev/null)
echo -e "${BLUE}📄 Recorded file: $TEMP_FILE (${FILE_SIZE} bytes)${NC}"

if [[ $FILE_SIZE -eq 0 ]]; then
    echo -e "${RED}❌ Recording file is empty${NC}"
    rm -f "$TEMP_FILE"
    exit 1
fi

# Test transcription with detailed error reporting
echo -e "${BLUE}🧠 Testing transcription with detailed logging...${NC}"

# Use base64 encoding to safely pass the file path
TEMP_FILE_B64=$(echo -n "$TEMP_FILE" | base64)

KOSHI_VOX_TEMP_FILE="$TEMP_FILE_B64" python3 << 'EOF'
import sys
import os
import traceback
import base64
import platform
import time

print("🔍 Starting Python transcription debug...")

try:
    # Safely decode the file path
    temp_file_b64 = os.environ.get('KOSHI_VOX_TEMP_FILE', '')
    if not temp_file_b64:
        print("❌ No audio file specified in environment")
        sys.exit(1)

    temp_file = base64.b64decode(temp_file_b64.encode()).decode('utf-8')

    # Validate file path (must be in /tmp and exist)
    if not temp_file.startswith('/tmp/'):
        print("❌ Invalid audio file path - not in /tmp")
        sys.exit(1)

    is_apple_silicon = (platform.system() == "Darwin" and platform.machine() == "arm64")
    parakeet_available = False
    whisper_available = False

    # Check Parakeet MLX availability
    if is_apple_silicon:
        try:
            import parakeet_mlx
            parakeet_available = True
            print("✅ parakeet-mlx available (primary engine)")
        except ImportError:
            print("⚠️  parakeet-mlx not installed (will use whisper fallback)")

    # Check faster-whisper availability
    try:
        from faster_whisper import WhisperModel
        import soundfile as sf
        import numpy as np
        whisper_available = True
        print("✅ faster-whisper available" + (" (fallback)" if parakeet_available else " (primary)"))
    except ImportError as e:
        print(f"{'⚠️' if parakeet_available else '❌'} faster-whisper not found: {e}")

    if not parakeet_available and not whisper_available:
        print("❌ No transcription engine available!")
        sys.exit(1)

    print(f"\n📂 Loading audio file: {temp_file}")
    if not os.path.exists(temp_file):
        print("❌ Audio file doesn't exist!")
        sys.exit(1)

    file_size = os.path.getsize(temp_file)
    print(f"📊 File size: {file_size} bytes")

    # Try Parakeet MLX first on Apple Silicon
    if parakeet_available:
        print("\n🦜 Testing Parakeet MLX transcription...")
        try:
            from parakeet_mlx import from_pretrained
            start = time.time()
            print("🔧 Loading Parakeet model (first load downloads ~1.2GB)...")
            model = from_pretrained("mlx-community/parakeet-tdt-0.6b-v2")
            load_time = time.time() - start
            print(f"✅ Model loaded in {load_time:.2f}s")

            start = time.time()
            result = model.transcribe(temp_file)
            transcribe_time = time.time() - start
            print(f"✅ Parakeet transcription completed in {transcribe_time:.2f}s")
            print(f"✅ Final transcription: '{result.text}'")

            if hasattr(result, 'sentences'):
                for i, sent in enumerate(result.sentences):
                    print(f"🎵 Sentence {i+1}: '{sent.text}' ({sent.start:.2f}s - {sent.end:.2f}s)")
        except Exception as e:
            print(f"❌ Parakeet transcription failed: {e}")
            traceback.print_exc()

    # Also test faster-whisper for comparison
    if whisper_available:
        print("\n🧠 Testing faster-whisper transcription...")
        try:
            audio, sr = sf.read(temp_file)
            audio = np.array(audio, dtype=np.float32)
            print(f"✅ Audio loaded: {len(audio)} samples at {sr}Hz")
            print(f"📊 Audio duration: {len(audio)/sr:.2f} seconds")
            print(f"📊 Audio range: {np.min(audio):.4f} to {np.max(audio):.4f}")

            if len(audio) == 0:
                print("❌ Audio array is empty!")
                sys.exit(1)

            start = time.time()
            model = WhisperModel("base", device="cpu", compute_type="int8", cpu_threads=8)
            load_time = time.time() - start
            print(f"✅ Whisper model loaded in {load_time:.2f}s")

            start = time.time()
            segments, info = model.transcribe(
                audio,
                beam_size=1,
                language="en",
                condition_on_previous_text=False,
                vad_filter=True,
                vad_parameters=dict(min_silence_duration_ms=300)
            )
            text_segments = list(segments)
            transcribe_time = time.time() - start

            print(f"✅ Whisper transcription completed in {transcribe_time:.2f}s")
            print(f"📊 Language: {info.language} (prob: {info.language_probability:.2f})")
            print(f"📊 Segments: {len(text_segments)}")

            for i, segment in enumerate(text_segments):
                print(f"🎵 Segment {i+1}: '{segment.text}' ({segment.start:.2f}s - {segment.end:.2f}s)")

            final_text = " ".join([s.text for s in text_segments]).strip()
            if not final_text:
                print("⚠️  No text was transcribed (empty result)")
            else:
                print(f"✅ Final transcription: '{final_text}'")
        except Exception as e:
            print(f"❌ Whisper transcription failed: {e}")
            traceback.print_exc()

except Exception as e:
    print(f"❌ Critical error: {e}")
    traceback.print_exc()
    sys.exit(1)

print("\n✅ Debug completed successfully!")
EOF

echo ""
echo -e "${BLUE}🧹 Cleaning up...${NC}"
rm -f "$TEMP_FILE"
echo -e "${GREEN}Debug session complete!${NC}"